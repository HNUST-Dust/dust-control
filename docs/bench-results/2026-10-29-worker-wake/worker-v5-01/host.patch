+    def test_v4_worker_markers_optional_and_ordered(self):
+        old,row=self.fixture()
+        values=list(d.RECORD.unpack_from(old,d.HEADER.size))
+        cycles=values[9:]
+        values[0]=42
+        values[1]=(1<<21)-1
+        values += [cycles[10]+40, cycles[11]-40, cycles[11]+120,
+                   cycles[10]+80, cycles[10]+120]
+        header=d.HEADER.pack(0x31525444,4,208,128,1,0,24000000,40,7)
+        def decode():
+            return d.join(header+d.RECORD_V4.pack(*values)+bytes(127*208),[row])[0]
+        self.assertEqual(decode()['trace_status'],'ok')
+        self.assertEqual(decode()['mcu_worker_wake_to_worker_locked_us'],'1.667')
+        values[1]=(1<<19)-1
+        self.assertEqual(decode()['trace_status'],'ok')
+        values[1]=(1<<21)-1
+        values[-1]=values[-2]-1
+        self.assertIn('nonmonotonic_worker_wake_worker_locked',decode()['trace_status'])
+
+    def test_v5_can3_scan_boundary(self):
+        old,row=self.fixture()
+        values=list(d.RECORD.unpack_from(old,d.HEADER.size))
+        cycles=values[9:]
+        values[0]=44
+        values[1]=(1<<22)-1
+        values += [cycles[10]+40, cycles[11]-40, cycles[11]+120,
+                   cycles[10]+80, cycles[10]+120, cycles[10]+160]
+        header=d.HEADER.pack(0x31525444,5,216,128,1,0,24000000,40,7)
+        def decode():
+            return d.join(header+d.RECORD_V5.pack(*values)+bytes(127*216),[row])[0]
+        self.assertEqual(decode()['trace_status'],'ok')
+        self.assertEqual(decode()['mcu_worker_locked_to_can3_scan_us'],'1.667')
+        values[1]=(1<<19)-1
+        self.assertEqual(decode()['trace_status'],'ok')
+        values[1]=(1<<22)-1
+        values[-1]=cycles[11]+40
+        self.assertIn('nonmonotonic_can3_scan_can_dequeued',decode()['trace_status'])
+
