@@ -603,6 +603,22 @@ static int igc_ptp_set_timestamp_mode(struct igc_adapter *adapter,
 	return 0;
 }
 
+/* Isolated lab helper: RX only; no TX timestamp requests. */
+int igc_ecat_diag_timestamp(struct igc_adapter *adapter)
+{
+	struct hwtstamp_config config = {
+		.flags = 0, .tx_type = HWTSTAMP_TX_OFF,
+		.rx_filter = HWTSTAMP_FILTER_ALL,
+	};
+	int ret;
+	if (!adapter->ptp_clock)
+		return -ENODEV;
+	ret = igc_ptp_set_timestamp_mode(adapter, &config);
+	if (!ret)
+		adapter->tstamp_config = config;
+	return ret;
+}
