diff --git a/samples/ecat/Middleware/ESC/hpm5e31_phy.c b/samples/ecat/Middleware/ESC/hpm5e31_phy.c
index 374e62f..f312ed0 100644
--- a/samples/ecat/Middleware/ESC/hpm5e31_phy.c
+++ b/samples/ecat/Middleware/ESC/hpm5e31_phy.c
@@ -224,10 +224,13 @@ hpm_stat_t ecat_phy_config(const struct device *esc_dev)
 	return status_success;
 }
 
+static int prev0 = -1, prev1 = -1;
+
 void ecat_phy_update_link(const struct device *esc_dev)
 {
-	static int prev0 = -1, prev1 = -1;
+#if defined(CONFIG_DUST_ECAT_PHY_RAW_DIAGNOSTICS)
 	static unsigned int dbg_cnt;
+#endif
 	uint16_t status = 0U, control = 0U;
 	int up;
 
@@ -269,7 +272,8 @@ void ecat_phy_update_link(const struct device *esc_dev)
 		prev1 = up;
 	}
 
-	/* Debug: periodic raw dump (every ~2s at the 100ms poll rate). */
+#if defined(CONFIG_DUST_ECAT_PHY_RAW_DIAGNOSTICS)
+	/* Optional raw diagnostics; actual link detection above remains unconditional. */
 	if (++dbg_cnt >= 20U) {
 		dbg_cnt = 0U;
 		uint16_t b0, b1;
@@ -278,4 +282,73 @@ void ecat_phy_update_link(const struct device *esc_dev)
 		printk("ESC phy dump: Port0 BMSR=0x%04x(%d) Port1 BMSR=0x%04x(%d)\n",
 		       b0, r0, b1, r1);
 	}
+#endif
+}
+
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+/* Owner-thread only. At most one normal MDIO read per call; false keeps the
+ * existing poll due so the owner checks PDI/Sync0 before the next read.
+ * Preserve latch-low double reads and fail closed on any read error. */
+bool ecat_phy_update_link_step(const struct device *esc_dev)
+{
+#if defined(CONFIG_DUST_ECAT_PHY_RAW_DIAGNOSTICS)
+	/* Explicit raw diagnostic builds retain the original complete dump. */
+	ecat_phy_update_link(esc_dev);
+	return true;
+#else
+	static unsigned phase;
+	static uint16_t status;
+	uint16_t value = 0U;
+	int ret;
+	bool up;
+	if (phase < 3U) {
+		if (!port0_configured) {
+			up = false;
+		} else {
+			ret = phy_read(esc_dev, BOARD_ECAT_PORT0_PHY_ADDR,
+				       phase == 2U ? PHY_BMCR_REG : PHY_BMSR_REG, &value);
+			/* First BMSR read only clears the latch; second is validated. */
+			if (ret == 0 && (phase == 0U || value != 0xffffU)) {
+				if (phase < 2U) {
+					status = value;
+					++phase;
+					return false;
+				}
+				up = (status & PHY_LINK_STATUS) &&
+				     (value & (BIT(13) | BIT(8))) == (BIT(13) | BIT(8));
+			} else {
+				up = false;
+			}
+		}
+		hpm_esc_set_link_state(esc_dev, 0, up);
+		if ((int)up != prev0) {
+			printk("ESC Port0 link %s\n", up ? "up" : "down");
+			prev0 = up;
+		}
+		phase = 3U;
+		return false;
+	}
+	if (port1_configured) {
+		ret = phy_read(esc_dev, BOARD_ECAT_PORT1_PHY_ADDR, PHY_BMSR_REG, &value);
+		if (ret == 0 && (phase == 3U || value != 0xffffU)) {
+			if (phase == 3U) {
+				phase = 4U;
+				return false;
+			}
+			up = (value & PHY_LINK_STATUS) != 0;
+		} else {
+			up = false;
+		}
+	} else {
+		up = false;
+	}
+	hpm_esc_set_link_state(esc_dev, 1, up);
+	if ((int)up != prev1) {
+		printk("ESC Port1 link %s\n", up ? "up" : "down");
+		prev1 = up;
+	}
+	phase = 0U;
+	return true;
+#endif
 }
+#endif
