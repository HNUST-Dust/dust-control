     enum can_state state;
     (void)hpm_mcan_get_state(dev, &state, NULL);
     if (!data->started || state == CAN_STATE_BUS_OFF) {
         result = data->started ? -ENETUNREACH : -ENETDOWN;
         goto rejected;
     }
+
+#if defined(CONFIG_DUST_ECAT_DC_PROFILE)
