{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "production",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/production",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "DUST_BUILD_MPC": "OFF",
        "DUST_BUILD_TOOLS": "OFF",
        "DUST_BUILD_IGH": "ON",
        "DUST_BUILD_ROS2": "ON"
      }
    },
    {
      "name": "hardware",
      "inherits": "production",
      "binaryDir": "${sourceDir}/build/hardware",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "development",
      "inherits": "production",
      "binaryDir": "${sourceDir}/build/development",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "DUST_BUILD_MPC": "ON",
        "DUST_BUILD_TOOLS": "ON",
        "DUST_BUILD_IGH": "OFF"
      }
    },
    {
      "name": "headless",
      "inherits": "development",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "DUST_BUILD_ROS2": "OFF",
        "DUST_BUILD_IGH": "OFF"
      }
    },
    {
      "name": "ethercat-ci",
      "inherits": "production",
      "binaryDir": "${sourceDir}/build/ethercat-ci",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "DUST_BUILD_IGH": "OFF"
      }
    },
    {
      "name": "ros-orb",
      "inherits": "ethercat-ci",
      "displayName": "Colcon: Orb offline ROS",
      "binaryDir": "${sourceDir}/build/ros/dust_control"
    },
    {
      "name": "ros-nuc",
      "inherits": "hardware",
      "displayName": "Colcon: NUC hardware ROS",
      "binaryDir": "${sourceDir}/build/ros/dust_control"
    }
  ],
  "buildPresets": [
    {
      "name": "production",
      "configurePreset": "production"
    },
    {
      "name": "development",
      "configurePreset": "development"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "ethercat-ci",
      "configurePreset": "ethercat-ci"
    },
    {
      "name": "hardware",
      "configurePreset": "hardware"
    }
  ],
  "testPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ethercat-ci",
      "configurePreset": "ethercat-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hardware",
      "configurePreset": "hardware",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
